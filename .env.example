# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your key.  NEVER commit the real .env.
#   Windows CMD:  copy .env.example .env
# ---------------------------------------------------------------------------

# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_API_KEY_HERE

# --- AI model (change these two lines to swap models, no code edits needed) --
AI_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=90

# Set to 1 to run with fake AI replies (no API key or internet needed).
# Great for testing the UI. Set back to 0 to talk to the real model.
AI_OFFLINE_MOCK=0

# --- App ---
APP_NAME=Nova
DEBUG=0
SITE_URL=http://localhost:8000

# --- Limits ---
MAX_MESSAGE_CHARS=10000
# How many past messages are re-sent to the AI as conversation memory.
HISTORY_LIMIT=20

# --- Long-term memory (facts remembered across ALL chats) ---
MEMORY_ENABLED=true
# Also ask the AI to spot facts. Costs one extra small request per reply.
# Set to false to rely on the instant rule-based extraction only.
MEMORY_AI_EXTRACTION=true
MEMORY_MAX_FACTS=120

# --- File upload / document Q&A ---
MAX_UPLOAD_MB=10
DOC_CHUNK_CHARS=1400
DOC_CHUNK_OVERLAP=180
# Total characters of document excerpts sent with a question. Raise it for
# better answers on long files, lower it if you hit model context limits.
DOC_CONTEXT_CHARS=6000
DOC_MAX_CHUNKS=6

# --- Security ---
# Requests per minute per IP for /api/chat and /api/upload. 0 turns it off.
# Raise it if you hit the limit during normal use.
RATE_LIMIT_PER_MINUTE=60

# Password for the login screen.
# EMPTY = no login. That is fine when Nova only runs on your own PC.
# ⚠ If Nova is reachable from the internet (Cloudflare Tunnel, Fly.io, port
#   forwarding) you MUST set a password here. Otherwise strangers can use
#   your API key, read your memories, and run actions on your computer.
AUTH_PASSWORD=

# How long a login lasts, in hours (720 = 30 days).
SESSION_HOURS=720

# --- Actions ("JARVIS mode") ---
# Let Nova DO things: open websites and apps, manage files, run git.
# These run on the machine Nova runs on. Set to false for cloud deployments.
ACTIONS_ENABLED=true

# Ask before anything destructive (delete, move, git push). Keep this true.
ACTIONS_CONFIRM=true

# The ONLY folder Nova may read or change. Everything else is refused.
# Leave blank to use C:\Users\YourName\Nova
NOVA_WORKSPACE=

# Folder that git commands may run in. Leave blank to use the workspace.
GIT_ROOT=

# "*" is fine locally. In production list your real domain(s), comma-separated.
ALLOWED_ORIGINS=*

# --- Storage (leave blank locally; set these when deploying with a volume) ---
# DB_PATH=/data/chat.db
# UPLOAD_DIR=/data/uploads

# --- Optional: override the assistant's personality (single line) ---
# SYSTEM_PROMPT=You are a concise expert Python tutor.
